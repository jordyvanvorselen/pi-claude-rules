{
  "name": "@jordyvanvorselen/pi-claude-rules",
  "version": "0.1.3",
  "description": "Load Claude Code rules from .claude/rules into pi with hybrid read-before-mutation safety, eager loading, and post-tool compatibility modes.",
  "type": "module",
  "license": "MIT",
  "author": "Jordy van Vorselen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-claude-rules.git"
  },
  "homepage": "https://github.com/jordyvanvorselen/pi-claude-rules#readme",
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "claude-code",
    "rules",
    "cursor-rules",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . && npm run format",
    "lint:fix": "eslint . --fix && npm run format:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
